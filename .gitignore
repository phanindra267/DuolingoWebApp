# ===============
# SQLite database files (keep .gitkeep if needed)
# ===============
*.db
*.sqlite
*.sqlite3
!**/.gitkeep

# ===============
# Environment variables — NEVER commit secrets
# ===============
.env
.env.local
.env.*.local
.env.production
.env.development

