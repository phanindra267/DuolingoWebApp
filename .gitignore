# ===============
# Python / Backend (inside /backend)
# ===============
/backend/.venv/
/backend/venv/
/backend/env/
/backend/__pycache__/
/backend/**/__pycache__/
/backend/*.py[cod]
/backend/*$py.class
/backend/*.so
/backend/.Python
/backend/build/
/backend/develop-eggs/
/backend/dist/
/backend/downloads/
/backend/eggs/
